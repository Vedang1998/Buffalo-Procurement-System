modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
# Replit hosting may invoke its platform uv before the explicit project build.
# Keep the project-level uv pin out of pyproject.toml; CI/test tooling still pins 0.12.3.
build = "uvx uv@0.12.3 sync --frozen"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Procurement OS"

[[workflows.workflow]]
name = "Procurement OS"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd procurement && PYTHONPATH=src python3 -m uvicorn procurement_os.api:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["postgresql_16"]
