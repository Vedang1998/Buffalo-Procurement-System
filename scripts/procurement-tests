#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
runner="$repo_root/procurement/tools/run_tests.py"

# Never inherit the runtime/production database URL into deterministic tests.
unset DATABASE_URL

if [[ -n "${TEST_DATABASE_URL:-}" ]]; then
  cd "$repo_root"
  exec uv run --frozen python "$runner"
fi

for command in initdb pg_ctl createdb uv; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "ERROR: $command is required, or provide a loopback TEST_DATABASE_URL ending in _test" >&2
    exit 2
  fi
done

pg_root=$(mktemp -d /tmp/buffalo-procurement-tests.XXXXXX)
pg_data="$pg_root/data"
pg_log="$pg_root/postgres.log"
pg_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
pg_user=$(id -un)

cleanup() {
  if [[ -s "$pg_data/postmaster.pid" ]]; then
    pg_ctl -D "$pg_data" -m fast -w stop >/dev/null
  fi
  rm -r "$pg_root"
}
trap cleanup EXIT

initdb -D "$pg_data" -A trust --no-locale --encoding=UTF8 >/dev/null
pg_ctl -D "$pg_data" -l "$pg_log" -o "-h 127.0.0.1 -p $pg_port -k $pg_root" -w start >/dev/null
createdb -h 127.0.0.1 -p "$pg_port" -U "$pg_user" procurement_test

export TEST_DATABASE_URL="postgresql://$pg_user@127.0.0.1:$pg_port/procurement_test"
cd "$repo_root"
uv run --frozen python "$runner"
